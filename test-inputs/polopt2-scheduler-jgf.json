{
  "sched-fluxion-qmanager": {
    "queue-policy": "fcfs",
    "queue-params": {
      "queue-depth": 1024
    },
    "policy-params": {
      "reservation-depth": 16
    }
  },
  "sched-fluxion-resource": {
    "match-policy": "firstnodex",
    "match-format": "jgf",
    "prune-filters": "ALL:core"
  },
  "queues": {
    "pbatch": {
      "requires": [
        "pbatch"
      ]
    }
  },
  "policy": {
    "jobspec": {
      "defaults": {
        "system": {
          "queue": "pbatch"
        }
      }
    }
  }
}
