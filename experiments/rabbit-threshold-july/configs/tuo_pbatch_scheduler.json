{
  "sched-fluxion-qmanager": {
    "queue-policy": "fcfs",
    "queue-params": {
      "queue-depth": 2048
    },
    "policy-params": {
      "reservation-depth": 128
    }
  },
  "sched-fluxion-resource": {
    "match-policy": "firstnodex",
    "match-format": "rv1_shorthand"
  },
  "queues": {
    "pbatch": {
      "requires": ["pbatch"]
    }
  },
  "policy": {
    "jobspec": {
      "defaults": {
        "system": {
          "queue": "pbatch"
        }
      }
    }
  }
}
